{
    "builds": [
      {
        "src": "api/index.py",
        "use": "@vercel/python"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "api/index.py"
      }
    ],
    "devCommand": "uvicorn api.index:app --host 0.0.0.0 --port $PORT",
    "env": {
      "LOG_LEVEL": "INFO" 
    }
  }
  